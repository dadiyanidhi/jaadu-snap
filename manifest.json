{
  "manifest_version": 3,
  "name": "Meet Snap FX",
  "version": "1.1.0",
  "description": "Gesture-triggered live effects for Google Meet: snap to turn to dust, double snap for cash rain, hands up for absolute cinema, facepalm for… you know.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup/popup.html", "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" } },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["src/bridge.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["src/gestures.js", "src/effects.js", "src/camera.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["detector/*", "vendor/*", "models/*"],
      "matches": ["https://meet.google.com/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
